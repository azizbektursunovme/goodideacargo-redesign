# Where each form sends its JSON (agree on these with the backend developer; the old API was plain http
# and browsers blocked it, so the new one must be https). Empty = preview mode: nothing is sent anywhere.
PUBLIC_QUOTE_ENDPOINT=
PUBLIC_DRIVE_ENDPOINT=
PUBLIC_CONTACT_ENDPOINT=

# Meta (Facebook/Instagram) ads: Pixel ID from Events Manager and the domain verification code from
# Business Settings > Brand safety > Domains. Empty = no Pixel and no tag.
PUBLIC_META_PIXEL_ID=
PUBLIC_FB_DOMAIN_VERIFICATION=

# Canonical/og:url origin. Defaults to https://goodideacargo.com.
PUBLIC_CANONICAL_ORIGIN=

# "true" adds <meta name="robots" content="noindex"> (used for the GitHub Pages preview).
PUBLIC_NOINDEX=
