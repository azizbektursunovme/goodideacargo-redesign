---
// Phone, email, office and hours beside the forms.
import { company, links, fullAddress, hours } from '../data/site';

interface Props { title: string; text: string }
const { title, text } = Astro.props;
---
<aside class="contact-panel on-dark" aria-labelledby="panel-title">
  <div>
    <h2 id="panel-title">{title}</h2>
    <p>{text}</p>
  </div>
  <a class="contact-panel__phone" href={company.phoneHref}>{company.phone}</a>
  <dl>
    <div><dt>Office hours</dt><dd>{hours.office}</dd></div>
    <div><dt>Dispatch</dt><dd>{hours.dispatch}</dd></div>
    <div><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
    <div><dt>Office</dt><dd><a href={links.maps} target="_blank" rel="noopener">{fullAddress}</a></dd></div>
  </dl>
  {Astro.slots.has('default') && <p><slot /></p>}
</aside>
