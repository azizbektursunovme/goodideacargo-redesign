---
// Drive with Us application: one column on every screen. Sends JSON to PUBLIC_DRIVE_ENDPOINT.
// Asks for no license number, SSN or medical card: recruiting collects documents after the first call.
import LeadForm from './LeadForm.astro';
import { driverRoles, cdlOptions, experienceOptions } from '../data/site';

const endpoint = import.meta.env.PUBLIC_DRIVE_ENDPOINT ?? '';
---
<LeadForm
  id="drive-form"
  endpoint={endpoint}
  source="website-driver-application"
  submitLabel="Send application"
  sendingLabel="Sending application…"
  successTitle="Application sent"
  successText="Thank you. Our recruiting team will call you to talk about lanes, pay and home time."
  replyNote="Our recruiting team calls you back."
>
  <fieldset class="step" aria-labelledby="d-step-1">
    <div class="step__head">
      <span class="step__num" aria-hidden="true">1</span>
      <div>
        <h3 class="step__title" id="d-step-1">About you</h3>
        <p class="step__hint">How we reach you.</p>
      </div>
    </div>
    <div class="form-grid">
      <div class="field">
        <label class="label" for="d-name">Full name</label>
        <input class="input" id="d-name" name="name" autocomplete="name" required minlength="2" data-msg="Enter your full name." aria-describedby="d-name-err" />
        <p class="field-error" id="d-name-err"></p>
      </div>
      <div class="field">
        <label class="label" for="d-email">Email</label>
        <input class="input" id="d-email" name="email" type="email" autocomplete="email" required placeholder="name@example.com" data-msg="Enter an email address like name@example.com." aria-describedby="d-email-err" />
        <p class="field-error" id="d-email-err"></p>
      </div>
      <div class="field">
        <label class="label" for="d-phone">Phone</label>
        <input class="input" id="d-phone" name="phone" type="tel" autocomplete="tel" required pattern="[0-9()+.\s-]{10,20}" placeholder="(206) 555-0100" data-msg="Enter a phone number with area code." aria-describedby="d-phone-err" />
        <p class="field-error" id="d-phone-err"></p>
      </div>
    </div>
  </fieldset>

  <fieldset class="step" aria-labelledby="d-step-2">
    <div class="step__head">
      <span class="step__num" aria-hidden="true">2</span>
      <div>
        <h3 class="step__title" id="d-step-2">Your driving</h3>
        <p class="step__hint">No CDL yet? Choose it anyway and tell us below.</p>
      </div>
    </div>
    <div class="form-grid">
      <div class="field" role="radiogroup" aria-labelledby="d-role-label">
        <span class="label" id="d-role-label">I want to drive as</span>
        <div class="choice-cards">
          {driverRoles.map((r, i) => (
            <label class="choice-card"><input type="radio" name="role" value={r} checked={i === 0} /><span><strong>{r}</strong></span></label>
          ))}
        </div>
      </div>
      <div class="field">
        <label class="label" for="d-cdl">CDL</label>
        <select class="input" id="d-cdl" name="cdl" required data-msg="Choose your CDL type." aria-describedby="d-cdl-err">
          <option value="">Choose your CDL</option>
          {cdlOptions.map((o) => <option>{o}</option>)}
        </select>
        <p class="field-error" id="d-cdl-err"></p>
      </div>
      <div class="field">
        <label class="label" for="d-exp">Driving experience</label>
        <select class="input" id="d-exp" name="experience" required data-msg="Choose your years of experience." aria-describedby="d-exp-err">
          <option value="">Choose experience</option>
          {experienceOptions.map((o) => <option>{o}</option>)}
        </select>
        <p class="field-error" id="d-exp-err"></p>
      </div>
      <div class="field">
        <label class="label" for="d-message">Anything else? <span class="opt">Optional</span></label>
        <textarea class="input" id="d-message" name="message" rows="3" placeholder="Equipment, lanes you like, when you can start"></textarea>
      </div>
      <div class="field consents">
        <label class="consent"><input type="checkbox" name="smsConsent" value="yes" /><span>Text me about my application <span class="opt">(optional)</span>. Message and data rates may apply. Reply STOP to opt out. Consent is not required to apply.</span></label>
      </div>
    </div>
  </fieldset>
</LeadForm>
