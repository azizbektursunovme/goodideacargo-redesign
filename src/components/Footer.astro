---
import Icon from './Icon.astro';
import { company, links, fullAddress, hours, social } from '../data/site';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={url('/')} aria-label={`${company.name}, home`}>
          <img src={url('brand/logo.svg')} width="72" height="72" alt="" loading="lazy" />
          <span class="brand__name">Good Idea Cargo</span>
        </a>
        <p>{company.legalName} provides professional freight transportation services across all 48 contiguous states. Fast, safe, and on-time delivery you can count on.</p>
        {(company.dot || company.mc) && (
          <p>{company.dot && <>USDOT {company.dot}</>}{company.dot && company.mc && <br />}{company.mc && <>MC {company.mc}</>}</p>
        )}
      </div>

      <div class="footer-col">
        <h2>Pages</h2>
        <ul>
          <li><a href={url('why-us/')}>Why Us</a></li>
          <li><a href={url('service/')}>Services</a></li>
          <li><a href={url('trucking/')}>Fleet</a></li>
          <li><a href={url('drive-with-us/')}>Drive with Us</a></li>
          <li><a href={url('quote/')}>Get a Quote</a></li>
          <li><a href={url('contact/')}>Contact</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2>Contact</h2>
        <ul>
          <li><Icon name="pin" /><a href={links.maps} rel="noopener" target="_blank">{fullAddress}</a></li>
          <li><Icon name="phone" /><a href={company.phoneHref}>{company.phone}</a></li>
          <li><Icon name="mail" /><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><Icon name="clock" /><span>{hours.office}<br />{hours.dispatch}</span></li>
          {social.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {company.legalName}. All rights reserved.</p>
      <ul>
        <li><a href={url('privacy-policy/')}>Privacy Policy</a></li>
        <li><a href={url('terms-of-use/')}>Terms of Use</a></li>
      </ul>
    </div>
  </div>
</footer>
