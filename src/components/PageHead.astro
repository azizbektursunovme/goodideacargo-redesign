---
// Inner page header: a road photo with the page title on a guide-sign plate.
import Photo from './Photo.astro';

interface Props { title: string; lede?: string; photo?: string }
const { title, lede, photo } = Astro.props;
---
<section class={photo ? 'page-head' : 'page-head page-head--plain'}>
  {photo && <Photo name={photo} widths={[800, 1440]} sizes="100vw" width={1440} height={810} alt="" eager />}
  <div class="wrap page-head__sign">
    <div class="plate on-dark">
      <h1>{title}</h1>
      {lede && <p>{lede}</p>}
      <slot />
    </div>
  </div>
</section>
