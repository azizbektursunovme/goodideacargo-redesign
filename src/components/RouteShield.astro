---
// Interstate route marker drawn in the sign's white (decorative: the routes that meet near Renton).
interface Props { route: string }
const { route } = Astro.props;
const size = route.length > 2 ? 12 : route.length > 1 ? 15 : 18;
---
<svg viewBox="0 0 40 44" aria-hidden="true" focusable="false">
  <path d="M3 8c6-4 11-5 17-2 6-3 11-2 17 2v12c0 11-8 18-17 22C11 38 3 31 3 20z" fill="none" stroke="#fff" stroke-width="2.2" stroke-linejoin="round" />
  <path d="M3.6 14.5h32.8" stroke="#fff" stroke-width="1.6" />
  <text x="20" y="31" text-anchor="middle" fill="#fff" font-family="Overpass, Arial, sans-serif" font-weight="800" font-size={size}>{route}</text>
</svg>
