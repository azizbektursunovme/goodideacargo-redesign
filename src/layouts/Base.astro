---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company, social } from '../data/site';
import { url } from '../lib/url';
import { ORIGIN } from '../lib/seo';

interface Preload { srcset: string; sizes: string; media?: string }
interface Props {
  title: string;
  description: string;
  current?: 'home' | 'why' | 'services' | 'fleet' | 'drive' | 'quote' | 'contact' | 'legal' | 'other';
  noindex?: boolean;
  preload?: Preload[];
}

const { title, description, current = 'other', noindex = false, preload = [] } = Astro.props;
// canonical and og:url always point at the real domain, also on the GitHub Pages preview.
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.startsWith(base) ? `/${Astro.url.pathname.slice(base.length)}` : Astro.url.pathname;
const canonical = new URL(path.replace(/\/{2,}/g, '/'), ORIGIN).href;
const hideFromSearch = noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const font = (w: number) => url(`fonts/poppins-latin-${w}.woff2`);
const fontFaces = [400, 500, 600, 700].map((w) => `@font-face{font-family:'Poppins';src:url('${font(w)}') format('woff2');font-weight:${w};font-style:normal;font-display:swap}`).join('');
// Meta (Facebook/Instagram) ads: the Pixel loads only when its ID is configured, and domain verification
// is a meta tag from Business Settings. Both empty on the preview.
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '';
const fbDomainVerification = import.meta.env.PUBLIC_FB_DOMAIN_VERIFICATION ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  legalName: company.legalName,
  url: `${ORIGIN}/`,
  logo: `${ORIGIN}/brand/logo.png`,
  telephone: '+1-206-704-4444',
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    addressLocality: company.city,
    addressRegion: company.state,
    postalCode: company.zip,
    addressCountry: 'US',
  },
  areaServed: 'US',
  ...(social.length ? { sameAs: social.map((s) => s.url) } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#09111f" />
    <link rel="icon" type="image/svg+xml" href={url('brand/logo.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('brand/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('brand/apple-touch-icon.png')} />
    <link rel="preload" href={font(400)} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font(600)} as="font" type="font/woff2" crossorigin />
    {preload.map((p) => (
      <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes} media={p.media} fetchpriority="high" />
    ))}
    <style is:inline set:html={fontFaces}></style>
    {fbDomainVerification && <meta name="facebook-domain-verification" content={fbDomainVerification} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={`${ORIGIN}/brand/og-image.jpg`} />
    <meta property="og:locale" content="en_US" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {pixelId && (
      <script is:inline define:vars={{ pixelId }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId); fbq('track', 'PageView');
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <!-- Phone links (tel:) open the phone's Phone app on phones and tablets.
         On a computer without touch, where nothing would open, the click copies the number and says so. -->
    <div class="toast" id="call-toast" role="status" aria-live="polite" data-phone={company.phone} hidden></div>
    <script>
      const toast = document.getElementById('call-toast');
      const canCall = () =>
        navigator.maxTouchPoints > 0 ||
        window.matchMedia('(any-pointer: coarse)').matches ||
        /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
      let timer: number | undefined;
      if (toast) {
        document.addEventListener('click', async (e) => {
          const link = (e.target as Element | null)?.closest?.('a[href^="tel:"]');
          if (!link || canCall()) return;
          e.preventDefault();
          const phone = toast.dataset.phone || link.getAttribute('href')!.slice(4);
          let copied = false;
          try { await navigator.clipboard.writeText(phone); copied = true; } catch { /* clipboard blocked */ }
          toast.innerHTML = copied
            ? `<strong>Number copied: ${phone}</strong><span>Call us from your phone.</span>`
            : `<strong>Call us: ${phone}</strong><span>Mon–Fri, 5 AM – 5 PM PT. Emergency dispatch 24/7.</span>`;
          toast.hidden = false;
          window.clearTimeout(timer);
          timer = window.setTimeout(() => { toast.hidden = true; }, 4500);
        });
      }

      // Meta Pixel conversion events, sent only after the server confirmed the form (see LeadForm).
      const events: Record<string, string> = { 'quote-form': 'Lead', 'drive-form': 'SubmitApplication', 'contact-form': 'Contact' };
      document.addEventListener('lead:sent', (e) => {
        const id = (e.target as HTMLElement)?.id;
        const fbq = (window as unknown as { fbq?: (...a: unknown[]) => void }).fbq;
        if (fbq && events[id]) fbq('track', events[id]);
      });
    </script>
  </body>
</html>
