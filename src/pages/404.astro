---
import Base from '../layouts/Base.astro';
import { company } from '../data/site';
import { url } from '../lib/url';
---
<Base title="Page not found | Good Idea Cargo" description="This page does not exist." noindex>
  <section class="wrap notfound">
    <div class="plate on-dark">
      <p>Wrong turn</p>
      <h1>This page is not on our route</h1>
      <p>It may have moved, or the link is old. Head back to the home page, or call us at <a href={company.phoneHref}>{company.phone}</a>.</p>
      <p><a class="btn" href={url('/')}>Go to the home page</a></p>
      <p><a href={url('quote/')}>Get a quote</a></p>
    </div>
  </section>
</Base>
