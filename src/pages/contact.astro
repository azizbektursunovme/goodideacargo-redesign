---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { company, fullAddress } from '../data/site';
---
<Base
  title="Contact | Good Idea Cargo"
  description={`Call ${company.phone}, email ${company.email} or visit ${fullAddress}. Office hours Mon–Fri, 5 AM – 5 PM Pacific; emergency dispatch 24/7.`}
  current="contact"
>
  <PageBanner photo="band-contact" title="Contact" />
  <section class="section section--grey" aria-label="Contact details and form">
    <ContactBlock />
  </section>
</Base>
