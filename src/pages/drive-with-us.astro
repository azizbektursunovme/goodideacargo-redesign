---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import DriveForm from '../components/DriveForm.astro';
import Icon from '../components/Icon.astro';
import { company, driverBenefits } from '../data/site';

const benefitIcons = ['note', 'route', 'clock', 'phone', 'shield', 'check'];
---
<Base
  title="Drive with Us | Good Idea Cargo"
  description="Owner-operators and drivers: consistent loads across the 48 states, weekly direct deposit and 24/7 dispatch. Apply to drive with Good Idea Cargo."
  current="drive"
>
  <PageBanner photo="band-drive" title="Drive with Us" />

  <section class="section" aria-labelledby="intro-title">
    <div class="wrap split">
      <div class="split__copy">
        <span class="eyebrow">Join our team</span>
        <h2 id="intro-title">Drive for us. Earn more.</h2>
        <p>Good Idea Cargo connects owner-operators and drivers with consistent loads across the 48 contiguous states. Join our growing network today.</p>
        <div class="btn-row">
          <a class="btn" href="#apply">Apply Now</a>
          <a class="btn btn--outline" href={company.phoneHref}>Call Us</a>
        </div>
      </div>
      <ul class="cards cards--2">
        {driverBenefits.slice(0, 4).map((b, i) => <li class="card"><span class="icon-box"><Icon name={benefitIcons[i]} /></span><h3>{b.title}</h3><p>{b.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--grey" id="apply" aria-labelledby="apply-title">
    <div class="wrap" style="max-width:780px">
      <div class="section-head">
        <h2 id="apply-title">Apply now</h2>
        <span class="section-head__line" aria-hidden="true"></span>
        <p>Fill out the form and our recruiting team will call you back.</p>
      </div>
      <DriveForm />
    </div>
  </section>
</Base>
