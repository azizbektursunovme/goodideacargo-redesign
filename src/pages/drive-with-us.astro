---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import DriveForm from '../components/DriveForm.astro';
import { company, driverBenefits } from '../data/site';
---
<Base
  title="Drive with Us: owner-operators and drivers | Good Idea Cargo"
  description="Drive with Good Idea Cargo: steady freight lanes across the 48 states, weekly direct deposit and 24/7 dispatch. Apply online in two minutes."
  current="drive"
>
  <PageHead photo="band-drive" title="Drive with us" lede="Owner-operators and company drivers: steady lanes across the 48 states, weekly pay and dispatch that has your back.">
    <p><a class="btn" href="#apply">Apply now</a></p>
  </PageHead>

  <section class="section" aria-labelledby="benefits-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="benefits-title">What you get</h2>
        <p>Clear pay, steady work and a team that backs you up.</p>
      </div>
      <ul class="benefits">
        {driverBenefits.map((b) => <li><h3>{b.title}</h3><p>{b.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft" id="apply" aria-labelledby="apply-title">
    <div class="wrap" style="max-width:760px">
      <div class="section-head">
        <h2 id="apply-title">Apply to drive</h2>
        <p>Two minutes. Our recruiting team calls you back. Questions first? Call <a href={company.phoneHref}>{company.phone}</a>.</p>
      </div>
      <DriveForm />
    </div>
  </section>
</Base>
