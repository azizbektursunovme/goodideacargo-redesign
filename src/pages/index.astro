---
// Home: the current site's layout and words, with a real photo in the hero instead of the AI image,
// a trust block instead of "LIVE METRICS", services that never show "Loading..." and no empty reviews block.
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { company, links, fullAddress, hours, services, reviews } from '../data/site';
import { url } from '../lib/url';

const heroDesktop = [960, 1440, 1920].map((w) => `${url(`photos/hero-${w}.webp`)} ${w}w`).join(', ');
const heroMobile = [600, 900].map((w) => `${url(`photos/hero-m-${w}.webp`)} ${w}w`).join(', ');
---
<Base
  title="Good Idea Cargo | Reliable trucking services across the USA"
  description={`${company.legalName} provides freight transportation across all 48 contiguous states: full truckload, expedited and dedicated lanes. Call ${company.phone} or get a quote.`}
  current="home"
  preload={[
    { srcset: heroMobile, sizes: '100vw', media: '(max-width: 899px)' },
    { srcset: heroDesktop, sizes: '100vw', media: '(min-width: 900px)' },
  ]}
>
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero__media">
      <source media="(max-width: 899px)" srcset={heroMobile} sizes="100vw" />
      <img src={url('photos/hero-1440.webp')} srcset={heroDesktop} sizes="100vw" width="1920" height="1080" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class="wrap">
      <div class="hero__inner on-dark">
        <h1 id="hero-title">Reliable Trucking Services <span>Across the USA</span></h1>
        <p>{company.legalName} provides professional freight transportation services across all 48 contiguous states. Fast, safe, and on-time delivery you can count on.</p>
        <div class="btn-row">
          <a class="btn btn--lg" href={company.phoneHref}>Call Us Now</a>
          <a class="btn btn--outline btn--lg" href={url('quote/')}>Get a Quote</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark on-dark" aria-labelledby="trust-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="trust-title">A freight partner you can check before the first load</h2>
        <span class="section-head__line" aria-hidden="true"></span>
      </div>
      <ul class="facts-row">
        <li><strong>48</strong><span>States covered</span></li>
        <li><strong>24/7</strong><span>Emergency dispatch</span></li>
        <li><strong>3</strong><span>Freight services</span></li>
        <li><strong>{company.city}</strong><span>{company.stateName} office</span></li>
      </ul>
      <div class="company">
        <div class="company__intro">
          <span class="eyebrow">Who you are booking with</span>
          <h3>{company.legalName}</h3>
          <p>A trucking company with a real office and a team that answers the phone. Call before you book, or send the quote form.</p>
        </div>
        <dl>
          {company.dot && <div><dt>USDOT</dt><dd>{links.fmcsa ? <a href={links.fmcsa} target="_blank" rel="noopener">{company.dot}</a> : company.dot}</dd></div>}
          {company.mc && <div><dt>MC</dt><dd>{company.mc}</dd></div>}
          <div><dt>Office</dt><dd><a href={links.maps} target="_blank" rel="noopener">{fullAddress}</a></dd></div>
          <div><dt>Phone</dt><dd><a href={company.phoneHref}>{company.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
          <div><dt>Hours</dt><dd>{hours.office}<br />{hours.dispatch}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--grey" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-title">Services</h2>
        <span class="section-head__line" aria-hidden="true"></span>
        <p>Each solution is structured for reliable timing, clean communication and safer delivery.</p>
      </div>
      <ul class="cards cards--3">
        {services.map((s) => (
          <li class="card card--photo">
            <Photo name={s.photo} alt="" sizes="(min-width: 1000px) 400px, (min-width: 700px) 50vw, 100vw" />
            <div class="card__body">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <a class="card__link" href={url(`service/#${s.id}`)}>About {s.title.toLowerCase()}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="section" aria-labelledby="reviews-title">
      <div class="wrap">
        <div class="section-head"><h2 id="reviews-title">What our clients say</h2></div>
        <ul class="cards cards--3">
          {reviews.map((r) => <li class="card card--accent"><p>{r.quote}</p><h3>{r.name}</h3><p>{r.role}</p></li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="section" aria-label="Contact">
    <ContactBlock />
  </section>
</Base>
