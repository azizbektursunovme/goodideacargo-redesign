---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { company, services, quoteSteps } from '../data/site';
import { url } from '../lib/url';

const quoteLabel: Record<string, [string, string]> = {
  'full-truckload': ['Full truckload', 'Quote a full truckload'],
  expedited: ['Expedited', 'Quote an expedited load'],
  dedicated: ['Dedicated lane', 'Ask about a dedicated lane'],
};
---
<Base
  title="Services | Good Idea Cargo"
  description="Full truckload, expedited freight and dedicated lanes across the 48 contiguous states from Good Idea Cargo in Renton, Washington."
  current="services"
>
  <PageBanner photo="band-services" title="Services" />

  <section class="section" aria-labelledby="intro-title">
    <div class="wrap split">
      <div class="split__copy">
        <span class="eyebrow">Our services</span>
        <h2 id="intro-title">Freight solutions that deliver</h2>
        <p>Whether you need a full truckload, expedited freight or a custom shipping setup, Good Idea Cargo has the service to match your operation.</p>
        <ul class="chips">
          <li><Icon name="route" />Nationwide freight coverage</li>
          <li><Icon name="phone" />Dispatch-ready support</li>
          <li><Icon name="clock" />Flexible delivery options</li>
        </ul>
        <div class="btn-row">
          <a class="btn" href={company.phoneHref}>Call Us Now</a>
          <a class="btn btn--outline" href={url('quote/')}>Get a Free Quote</a>
        </div>
      </div>
      <Photo name="svc-ftl" widths={[480, 800]} alt="" sizes="(min-width: 900px) 560px, 100vw" />
    </div>
  </section>

  <section class="section section--grey" aria-labelledby="list-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="list-title">Built for real freight needs</h2>
        <span class="section-head__line" aria-hidden="true"></span>
        <p>Practical freight services for everyday shipments and urgent moves alike.</p>
      </div>
      <ul class="cards cards--3">
        {services.map((s) => (
          <li class="card card--photo" id={s.id}>
            <Photo name={s.photo} alt="" sizes="(min-width: 1000px) 400px, (min-width: 700px) 50vw, 100vw" />
            <div class="card__body">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <ul class="checks">{s.points.map((p) => <li>{p}</li>)}</ul>
              <p><a class="btn" href={url(`quote/?service=${encodeURIComponent(quoteLabel[s.id][0])}`)}>{quoteLabel[s.id][1]}</a></p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-title">
    <div class="wrap split">
      <div class="split__copy">
        <span class="eyebrow">Custom solution</span>
        <h2 id="steps-title">Need a shipping plan built around your load?</h2>
        <p>Every shipment is different. Tell Good Idea Cargo what you need, and we will help you choose the most efficient route, timing and freight setup for the job.</p>
        <div class="btn-row">
          <a class="btn" href={url('contact/')}>Talk to Us</a>
          <a class="btn btn--outline" href={url('quote/')}>Get a Quote</a>
        </div>
      </div>
      <ol class="steps">
        {quoteSteps.map((s) => <li><div><h3>{s.title}</h3><p>{s.body}</p></div></li>)}
      </ol>
    </div>
  </section>
</Base>
