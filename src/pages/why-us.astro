---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Icon from '../components/Icon.astro';
import { company, shipperReasons, driverBenefits } from '../data/site';
import { url } from '../lib/url';

const benefitIcons = ['note', 'route', 'clock', 'phone', 'shield', 'check'];
const pillars = [
  { title: 'Regulation-ready', body: 'Our office keeps the paperwork and filings in order, so drivers can focus on the road.' },
  { title: 'Protected', body: 'We confirm every load, lane and checkpoint before a wheel turns. No surprises.' },
  { title: 'Reliable', body: 'When conditions change, we respond fast with practical solutions that protect your schedule and your load.' },
];
---
<Base
  title="Why Us | Good Idea Cargo"
  description="Why shippers and drivers work with Good Idea Cargo: clear communication, weekly driver pay, steady lanes and 24/7 emergency dispatch from Renton, Washington."
  current="why"
>
  <PageBanner photo="band-why" title="Why Us" />

  <section class="section" aria-labelledby="intro-title">
    <div class="wrap split">
      <div class="split__copy">
        <span class="eyebrow">Why choose us</span>
        <h2 id="intro-title">A better road with Good Idea Cargo</h2>
        <p>We built Good Idea Cargo around one simple truth: when drivers succeed, the whole operation gets stronger. Clear pay, steady work and a team that backs you up.</p>
        <ul class="chips">
          <li><Icon name="check" />No hidden fees</li>
          <li><Icon name="check" />Weekly pay</li>
          <li><Icon name="check" />24/7 dispatch</li>
        </ul>
        <div class="btn-row">
          <a class="btn" href={url('drive-with-us/')}>Join Good Idea Cargo</a>
          <a class="btn btn--outline" href={url('service/')}>Our Services</a>
        </div>
      </div>
      <ul class="cards">
        {shipperReasons.map((r) => <li class="card card--accent"><h3>{r.title}</h3><p>{r.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--grey" aria-labelledby="benefits-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Driver benefits</span>
        <h2 id="benefits-title">Everything you need on the road</h2>
        <p>Not just jobs: careers built on real support, real pay and real respect for your time and your family.</p>
      </div>
      <ul class="cards cards--3">
        {driverBenefits.map((b, i) => (
          <li class="card"><span class="icon-box"><Icon name={benefitIcons[i % benefitIcons.length]} /></span><h3>{b.title}</h3><p>{b.body}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--dark on-dark" aria-labelledby="pillars-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Our foundation</span>
        <h2 id="pillars-title">Built on three core pillars</h2>
      </div>
      <ul class="cards cards--3">
        {pillars.map((p) => <li class="card"><h3>{p.title}</h3><p>{p.body}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--grey" aria-labelledby="cta-title">
    <div class="wrap cta-band">
      <span class="eyebrow">Now hiring</span>
      <h2 id="cta-title">Ready to drive with us?</h2>
      <p>Join our drivers and partners. Questions first? Call {company.phone}.</p>
      <div class="btn-row">
        <a class="btn" href={url('drive-with-us/#apply')}>Apply Now</a>
        <a class="btn btn--outline" href={url('quote/')}>Get a Quote</a>
      </div>
    </div>
  </section>
</Base>
